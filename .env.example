# Supabase — Project Settings > API Keys 에서 복사
# (신규 키 체계: "Publishable and secret API keys" 탭)

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# publishable key — 브라우저 노출 안전 (RLS 적용). 예: sb_publishable_xxxxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# secret key — 서버 전용, 절대 커밋/노출 금지. 예: sb_secret_xxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# --- 레거시 키를 쓰는 경우(둘 중 하나만 있으면 됨) ---
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
